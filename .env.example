# Server-side only. Never expose these to the browser.
SESSION_SECRET=change-me-to-a-long-random-string

# LLM provider adapter: offline (default, fully deterministic demo) | gemini | groq
# With "offline", everything works end-to-end with zero external calls:
# question generation, grading, diagnosis, planning and explanations all use
# deterministic algorithms over the uploaded material. LLM providers are an
# optional quality upgrade and fail-safe back to the deterministic path.
LLM_PROVIDER=offline
GEMINI_API_KEY=
GROQ_API_KEY=
